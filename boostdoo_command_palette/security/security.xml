<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Groups ===== -->
    <record id="group_boostdoo_command_palette_user" model="res.groups">
        <field name="name">Command Palette User</field>
        <field name="category_id" ref="base.module_category_usability"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_boostdoo_command_palette_manager" model="res.groups">
        <field name="name">Command Palette Manager</field>
        <field name="category_id" ref="base.module_category_usability"/>
        <field name="implied_ids" eval="[(4, ref('group_boostdoo_command_palette_user'))]"/>
    </record>

    <!-- ===== Record Rules ===== -->

    <!-- Favorites: users can only access their own -->
    <record id="rule_command_favorite_own" model="ir.rule">
        <field name="name">Command Favorite: own records only</field>
        <field name="model_id" ref="model_boostdoo_command_favorite"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_boostdoo_command_palette_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- History: users can only access their own -->
    <record id="rule_command_history_own" model="ir.rule">
        <field name="name">Command History: own records only</field>
        <field name="model_id" ref="model_boostdoo_command_history"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_boostdoo_command_palette_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>
